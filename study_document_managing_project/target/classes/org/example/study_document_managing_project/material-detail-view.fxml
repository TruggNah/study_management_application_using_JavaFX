<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="700.0" prefWidth="520.0" spacing="15.0" style="-fx-background-color: #f8f9fa; -fx-padding: 25;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.study_document_managing_project.MaterialDetailController">
    <children>
        <Label text="DOCUMENT DETAILS" textFill="#2c3e50" style="-fx-font-weight: bold;">
            <font>
                <Font size="22.0" />
            </font>
        </Label>

        <VBox spacing="10.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #bdc3c7; -fx-border-radius: 8;">
            <children>
                <Label fx:id="lblTitle" text="Title: " wrapText="true" style="-fx-font-weight: bold;" />
                <Label fx:id="lblSubject" text="Subject: " />
                <Label fx:id="lblCategory" text="Category: " />
                <Label fx:id="lblOwner" text="Owner: " />
                <Label fx:id="lblDownloads" text="Total Downloads: " />
                <Label fx:id="lblRating" text="Rating: " />
                <Label fx:id="lblUrl" text="File URL: " wrapText="true" textFill="#2980b9" />
            </children>
        </VBox>

        <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-padding: 12; -fx-background-color: #fff9e6; -fx-background-radius: 8; -fx-border-color: #f1c40f; -fx-border-radius: 8;">
            <children>
                <Label text="Your Rating (1-5 ⭐):" style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d;" />
                <ComboBox fx:id="cbRatingValue" prefWidth="80.0" style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 4;" />
                <Button fx:id="btnSubmitRating" mnemonicParsing="false" onAction="#handleRatingSubmit" prefHeight="30.0" style="-fx-background-color: #f1c40f; -fx-text-fill: #2c3e50; -fx-font-weight: bold; -fx-cursor: hand;" text="Submit Rating" />
            </children>
        </HBox>

        <VBox spacing="8.0" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 12; -fx-background-radius: 8; -fx-border-color: #eaeded; -fx-border-radius: 8;">
            <children>
                <Label text="💬 Public Comments" textFill="#34495e" style="-fx-font-weight: bold; -fx-font-size: 14;" />

                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" prefHeight="180.0" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: white;">
                    <content>
                        <VBox fx:id="vboxComments" spacing="10.0" style="-fx-padding: 5; -fx-background-color: white;" />
                    </content>
                </ScrollPane>

                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <children>
                        <TextField fx:id="txtCommentContent" HBox.hgrow="ALWAYS" prefHeight="35.0" promptText="Write a public comment..." style="-fx-background-radius: 20; -fx-padding: 0 15 0 15;" />
                        <Button fx:id="btnSendComment" mnemonicParsing="false" onAction="#handleCommentSubmit" prefHeight="35.0" prefWidth="80.0" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-cursor: hand;" text="Send" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <HBox alignment="CENTER" spacing="15.0">
            <children>
                <Button fx:id="btnDownload" mnemonicParsing="false" onAction="#handleDownloadAction" prefHeight="40.0" prefWidth="140.0" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="⬇ Download Now" />
                <Button fx:id="btnBookmark" mnemonicParsing="false" onAction="#handleBookmarkAction" prefHeight="40.0" prefWidth="160.0" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="⭐ Add to Bookmarks" />
                <Button fx:id="btnClose" mnemonicParsing="false" onAction="#handleClose" prefHeight="40.0" prefWidth="90.0" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-cursor: hand;" text="Close" />
                <Button fx:id="btnReport" mnemonicParsing="false" onAction="#handleOpenReportPopup" prefHeight="35.0" prefWidth="130.0" style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="⚠️ Report" />
            </children>
        </HBox>
    </children>
</VBox>