<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.layout.HBox?>
<AnchorPane prefHeight="450.0" prefWidth="500.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.study_document_managing_project.ReportController">
    <children>
        <VBox spacing="15.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
            <children>
                <Label style="-fx-font-weight: bold; -fx-text-fill: #c0392b;" text="REPORT DOCUMENT VIOLATION">
                    <font>
                        <Font size="18.0" />
                    </font>
                </Label>

                <GridPane hgap="10.0" vgap="8.0" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-background-radius: 8;">
                    <children>
                        <Label text="Document Title:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <Label fx:id="lblTitle" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                        <Label text="Category:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <Label fx:id="lblCategory" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <Label text="Subject:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <Label fx:id="lblSubject" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                        <Label text="File URL:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                        <Label fx:id="lblFileUrl" textFill="#2980b9" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                        <Label text="Reporter:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                        <Label fx:id="lblReporter" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                    </children>
                </GridPane>

                <Label text="Reason for Violation:" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                <TextArea fx:id="txtReason" prefHeight="120.0" promptText="Please clarify why this document violates system rules (e.g., spam, wrong subject, copyright infringement)..." style="-fx-border-color: #dcdde1; -fx-border-radius: 5;" wrapText="true" />

                <Label fx:id="lblMessage" textFill="#e74c3c" wrapText="true" />

                <HBox alignment="CENTER_RIGHT" spacing="12.0">
                    <children>
                        <Button fx:id="btnSubmit" onAction="#handleSubmitReport" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="Submit Report" />
                        <Button fx:id="btnCancel" onAction="#handleCancel" prefHeight="35.0" prefWidth="80.0" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;" text="Cancel" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>